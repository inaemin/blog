NEXT_PUBLIC_SITE_URL=https://your-blog.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# Vercel Web Analytics popular posts API
VERCEL_ACCESS_TOKEN=your_vercel_access_token
VERCEL_PROJECT_ID=your_vercel_project_id
# Optional for personal projects
VERCEL_TEAM_ID=your_vercel_team_id

# Optional: Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Optional: AI moderation
AI_API_KEY=your_ai_moderation_api_key
